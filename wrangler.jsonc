// Cloudflare Workers：發布 site/，找不到的路徑回傳 site/404.html。
// 只有講義 PDF 與網頁版內容先進 worker/handbook.js 驗證身分，其他網址仍由靜態資產直接回應。
{
  "name": "pixel-studio",
  "compatibility_date": "2026-10-01",
  "main": "worker/handbook.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/vocal/vocal-class-handbook.pdf",
      "/guitar/guitar-handbook.pdf",
      "/piano/piano-handbook.pdf",
      "/songwriting/songwriting-handbook.pdf",
      "/en/vocal/vocal-class-handbook.pdf",
      "/en/guitar/guitar-handbook.pdf",
      "/en/piano/piano-handbook.pdf",
      "/en/songwriting/songwriting-handbook.pdf",
      "/vocal/course-handbook.md",
      "/guitar/handbook.md",
      "/piano/handbook.md",
      "/songwriting/handbook.md",
      "/en/vocal/course-handbook.md",
      "/en/guitar/handbook.md",
      "/en/piano/handbook.md",
      "/en/songwriting/handbook.md"
    ]
  },
  "kv_namespaces": [
    { "binding": "HANDBOOKS", "id": "3684b5dd76644a99bb0a24117293f47f" }
  ],
  "vars": {
    // 與 site/assets/config.js 相同的公開網址
    "BACKEND_URL": "https://script.google.com/macros/s/AKfycbwI5bIe10gTTKDKFQVuqGowdg6a_mSjcr_tOPXCKUnd-PgQoFYqRuvG6WKWac0Cdwzibg/exec"
  }
}
